---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { business, services } from "../../data/site";

const serviceCopy: Record<string, { detail: string; group: string }> = {
  "residential-cleaning": { detail: "Recurring or one-time care for homes and apartments.", group: "Home care" },
  "deep-cleaning": { detail: "A detailed reset for buildup and overlooked areas.", group: "Extra attention" },
  "move-in-out-cleaning": { detail: "Detailed cleaning for an empty or nearly empty home.", group: "Fresh starts" },
  "commercial-cleaning": { detail: "Flexible cleaning for retail, hospitality and shared spaces.", group: "Business spaces" },
  "office-cleaning": { detail: "Ongoing or one-time care built around your workplace.", group: "Workplaces" },
};
---

<BaseLayout
  title="Plan Your Cleaning Service | Lules Multiservices NYC"
  description="Build a cleaning service request for your NYC home, office or business. Preview your selections before contacting Lules Multiservices."
>
  <section class="booking-hero warm-field">
    <div class="container booking-hero__inner" data-reveal>
      <p class="eyebrow">Plan your service</p>
      <h1>Tell us about your space.</h1>
      <p>Choose what you need and review the details in three simple steps. No payment is requested here.</p>
      <div class="privacy-note" role="note">
        <span aria-hidden="true">○</span>
        <span><strong>Preview mode:</strong> this form does not send or save your information.</span>
      </div>
    </div>
  </section>

  <section class="booking-section">
    <div class="container booking-layout">
      <div class="booking-main">
        <ol class="progress" aria-label="Quote progress">
          <li class="is-current" data-progress-step="1"><span>1</span><div><strong>Your space</strong><small>Service details</small></div></li>
          <li data-progress-step="2"><span>2</span><div><strong>Contact</strong><small>How to reach you</small></div></li>
          <li data-progress-step="3"><span>3</span><div><strong>Review</strong><small>Check your request</small></div></li>
        </ol>

        <form id="quote-builder" class="quote-builder" novalidate>
          <section class="form-step" data-step="1" aria-labelledby="step-one-title">
            <div class="step-heading">
              <span>Step 1 of 3</span>
              <h2 id="step-one-title">What would you like cleaned?</h2>
              <p>Start with the service. We’ll only show the questions that matter for that job.</p>
            </div>

            <div class="field field--area">
              <label for="service-area">Service area <span>*</span></label>
              <select id="service-area" name="serviceArea" required>
                <option value="">Select an area</option>
                <option>Manhattan</option>
                <option>Brooklyn</option>
                <option>Queens</option>
                <option>The Bronx</option>
                <option>Other / nearby area</option>
                <option>Not sure about coverage</option>
              </select>
              <small>Outside these areas? Choose “Other” and we’ll review availability with you.</small>
            </div>

            <fieldset class="service-fieldset">
              <legend>Choose one service <span>*</span></legend>
              <div class="service-options">
                {services.map((service) => {
                  const copy = serviceCopy[service.slug] ?? { detail: service.short, group: service.eyebrow };
                  return (
                    <label class="service-choice">
                      <input type="radio" name="service" value={service.slug} data-title={service.title} required />
                      <span class="service-choice__body">
                        <ServiceIcon name={service.slug} />
                        <span class="service-choice__copy">
                          <small>{copy.group}</small>
                          <strong>{service.title}</strong>
                          <span>{copy.detail}</span>
                        </span>
                        <span class="service-choice__check" aria-hidden="true">✓</span>
                      </span>
                    </label>
                  );
                })}
              </div>
            </fieldset>

            <div class="conditional-shell" id="service-details" hidden>
              <div class="conditional-intro">
                <span class="conditional-intro__number">2</span>
                <div><h3>Tell us a little more</h3><p>These questions change based on the service you selected.</p></div>
              </div>

              <div class="service-panel" data-service-panel="residential-cleaning" hidden>
                <div class="field-grid field-grid--3">
                  <div class="field"><label for="res-frequency">Frequency <span>*</span></label><select id="res-frequency" name="residentialFrequency" data-required><option value="">Select frequency</option><option>One-time</option><option>Weekly</option><option>Every two weeks</option><option>Monthly</option></select></div>
                  <div class="field"><label for="res-bedrooms">Bedrooms <span>*</span></label><select id="res-bedrooms" name="residentialBedrooms" data-required><option value="">Select</option><option>Studio</option><option>1 bedroom</option><option>2 bedrooms</option><option>3 bedrooms</option><option>4 bedrooms</option><option>5+ bedrooms</option></select></div>
                  <div class="field"><label for="res-bathrooms">Bathrooms <span>*</span></label><select id="res-bathrooms" name="residentialBathrooms" data-required><option value="">Select</option><option>1 bathroom</option><option>1.5 bathrooms</option><option>2 bathrooms</option><option>2.5 bathrooms</option><option>3 bathrooms</option><option>4+ bathrooms</option></select></div>
                </div>
                <div class="field-grid">
                  <div class="field"><label for="res-size">Approximate size</label><select id="res-size" name="residentialSize"><option value="">Select or skip</option><option>Under 500 sq ft</option><option>500–999 sq ft</option><option>1,000–1,499 sq ft</option><option>1,500–1,999 sq ft</option><option>2,000+ sq ft</option><option>Not sure</option></select></div>
                  <div class="field"><label for="res-condition">Current condition</label><select id="res-condition" name="residentialCondition"><option value="">Select or skip</option><option>Light upkeep</option><option>Average lived-in condition</option><option>Needs extra attention</option><option>Not sure</option></select></div>
                </div>
              </div>

              <div class="service-panel" data-service-panel="deep-cleaning" hidden>
                <div class="field-grid field-grid--3">
                  <div class="field"><label for="deep-bedrooms">Bedrooms <span>*</span></label><select id="deep-bedrooms" name="deepBedrooms" data-required><option value="">Select</option><option>Studio</option><option>1 bedroom</option><option>2 bedrooms</option><option>3 bedrooms</option><option>4+ bedrooms</option></select></div>
                  <div class="field"><label for="deep-bathrooms">Bathrooms <span>*</span></label><select id="deep-bathrooms" name="deepBathrooms" data-required><option value="">Select</option><option>1 bathroom</option><option>1.5 bathrooms</option><option>2 bathrooms</option><option>2.5 bathrooms</option><option>3+ bathrooms</option></select></div>
                  <div class="field"><label for="deep-size">Approximate size</label><select id="deep-size" name="deepSize"><option value="">Select or skip</option><option>Under 750 sq ft</option><option>750–1,499 sq ft</option><option>1,500–2,499 sq ft</option><option>2,500+ sq ft</option><option>Not sure</option></select></div>
                </div>
                <fieldset class="choice-group"><legend>Areas needing extra attention</legend><div class="check-grid"><label><input type="checkbox" name="deepFocus" value="Kitchen buildup" /> Kitchen buildup</label><label><input type="checkbox" name="deepFocus" value="Bathrooms" /> Bathrooms</label><label><input type="checkbox" name="deepFocus" value="Baseboards and trim" /> Baseboards & trim</label><label><input type="checkbox" name="deepFocus" value="Interior appliances" /> Interior appliances</label><label><input type="checkbox" name="deepFocus" value="Pet hair" /> Pet hair</label><label><input type="checkbox" name="deepFocus" value="Not sure" /> Not sure</label></div></fieldset>
              </div>

              <div class="service-panel" data-service-panel="move-in-out-cleaning" hidden>
                <fieldset class="choice-group"><legend>Type of move <span>*</span></legend><div class="segmented"><label><input type="radio" name="moveType" value="Move-in" data-required /><span>Move-in</span></label><label><input type="radio" name="moveType" value="Move-out" data-required /><span>Move-out</span></label><label><input type="radio" name="moveType" value="Both / not sure" data-required /><span>Both / not sure</span></label></div></fieldset>
                <div class="field-grid field-grid--3">
                  <div class="field"><label for="move-bedrooms">Bedrooms <span>*</span></label><select id="move-bedrooms" name="moveBedrooms" data-required><option value="">Select</option><option>Studio</option><option>1 bedroom</option><option>2 bedrooms</option><option>3 bedrooms</option><option>4+ bedrooms</option></select></div>
                  <div class="field"><label for="move-bathrooms">Bathrooms <span>*</span></label><select id="move-bathrooms" name="moveBathrooms" data-required><option value="">Select</option><option>1 bathroom</option><option>1.5 bathrooms</option><option>2 bathrooms</option><option>2.5 bathrooms</option><option>3+ bathrooms</option></select></div>
                  <div class="field"><label for="move-occupancy">Space status <span>*</span></label><select id="move-occupancy" name="moveOccupancy" data-required><option value="">Select</option><option>Empty</option><option>Mostly empty</option><option>Still furnished</option><option>Not sure yet</option></select></div>
                </div>
              </div>

              <div class="service-panel" data-service-panel="commercial-cleaning" hidden>
                <div class="field-grid">
                  <div class="field"><label for="commercial-type">Business type <span>*</span></label><select id="commercial-type" name="commercialType" data-required><option value="">Select</option><option>Retail store</option><option>Restaurant / hospitality</option><option>Studio / showroom</option><option>Building common area</option><option>Other business</option></select></div>
                  <div class="field"><label for="commercial-size">Approximate size <span>*</span></label><select id="commercial-size" name="commercialSize" data-required><option value="">Select</option><option>Under 1,000 sq ft</option><option>1,000–2,499 sq ft</option><option>2,500–4,999 sq ft</option><option>5,000+ sq ft</option><option>Not sure</option></select></div>
                  <div class="field"><label for="commercial-frequency">Frequency <span>*</span></label><select id="commercial-frequency" name="commercialFrequency" data-required><option value="">Select</option><option>One-time</option><option>Daily</option><option>2–3 times per week</option><option>Weekly</option><option>Every two weeks</option><option>Not sure yet</option></select></div>
                  <div class="field"><label for="commercial-window">Preferred window</label><select id="commercial-window" name="commercialWindow"><option value="">Select or skip</option><option>During business hours</option><option>Before business hours</option><option>After business hours</option><option>Flexible</option></select></div>
                </div>
                <fieldset class="choice-group"><legend>Areas to include</legend><div class="check-grid"><label><input type="checkbox" name="commercialAreas" value="Customer areas" /> Customer areas</label><label><input type="checkbox" name="commercialAreas" value="Bathrooms" /> Bathrooms</label><label><input type="checkbox" name="commercialAreas" value="Kitchen / prep area" /> Kitchen / prep area</label><label><input type="checkbox" name="commercialAreas" value="Floors" /> Floors</label><label><input type="checkbox" name="commercialAreas" value="Trash removal" /> Trash removal</label><label><input type="checkbox" name="commercialAreas" value="Interior glass" /> Interior glass</label></div></fieldset>
              </div>

              <div class="service-panel" data-service-panel="office-cleaning" hidden>
                <div class="field-grid">
                  <div class="field"><label for="office-type">Workplace type <span>*</span></label><select id="office-type" name="officeType" data-required><option value="">Select</option><option>Professional office</option><option>Medical / dental office</option><option>Coworking space</option><option>Small studio</option><option>Other workplace</option></select></div>
                  <div class="field"><label for="office-size">Approximate size <span>*</span></label><select id="office-size" name="officeSize" data-required><option value="">Select</option><option>Under 1,000 sq ft</option><option>1,000–2,499 sq ft</option><option>2,500–4,999 sq ft</option><option>5,000–9,999 sq ft</option><option>10,000+ sq ft</option><option>Not sure</option></select></div>
                  <div class="field"><label for="office-frequency">Frequency <span>*</span></label><select id="office-frequency" name="officeFrequency" data-required><option value="">Select</option><option>One-time</option><option>Daily</option><option>2–3 times per week</option><option>Weekly</option><option>Every two weeks</option><option>Monthly</option></select></div>
                  <div class="field"><label for="office-occupancy">Team size</label><select id="office-occupancy" name="officeOccupancy"><option value="">Select or skip</option><option>Under 10 people</option><option>10–25 people</option><option>26–50 people</option><option>51–100 people</option><option>100+ people</option></select></div>
                </div>
                <fieldset class="choice-group"><legend>Areas to include</legend><div class="check-grid"><label><input type="checkbox" name="officeAreas" value="Desks and work areas" /> Desks & work areas</label><label><input type="checkbox" name="officeAreas" value="Bathrooms" /> Bathrooms</label><label><input type="checkbox" name="officeAreas" value="Breakroom" /> Breakroom</label><label><input type="checkbox" name="officeAreas" value="Conference rooms" /> Conference rooms</label><label><input type="checkbox" name="officeAreas" value="Reception" /> Reception</label><label><input type="checkbox" name="officeAreas" value="Floors and trash" /> Floors & trash</label></div></fieldset>
              </div>

              <fieldset class="choice-group shared-addons">
                <legend>Optional extras</legend>
                <div class="check-grid"><label><input type="checkbox" name="extras" value="Inside oven" /> Inside oven</label><label><input type="checkbox" name="extras" value="Inside fridge" /> Inside fridge</label><label><input type="checkbox" name="extras" value="Interior windows" /> Interior windows</label><label><input type="checkbox" name="extras" value="Cabinet interiors" /> Cabinet interiors</label><label><input type="checkbox" name="extras" value="Laundry" /> Laundry</label><label><input type="checkbox" name="extras" value="Pet hair treatment" /> Pet hair treatment</label></div>
              </fieldset>
            </div>

            <div class="field field--notes"><label for="project-notes">Anything else we should know? <small>Optional</small></label><textarea id="project-notes" name="notes" rows="4" placeholder="Access details, areas of concern, pets, supplies or schedule notes..."></textarea></div>
            <div class="step-actions step-actions--end"><button class="button button--primary" type="button" data-next>Continue to contact <span aria-hidden="true">→</span></button></div>
          </section>

          <section class="form-step" data-step="2" aria-labelledby="step-two-title" hidden>
            <div class="step-heading"><span>Step 2 of 3</span><h2 id="step-two-title">How can we reach you?</h2><p>Use placeholder details if you’re only testing the planner. Nothing leaves this page.</p></div>
            <div class="field-grid">
              <div class="field"><label for="first-name">First name <span>*</span></label><input id="first-name" name="firstName" type="text" autocomplete="given-name" required /></div>
              <div class="field"><label for="last-name">Last name <span>*</span></label><input id="last-name" name="lastName" type="text" autocomplete="family-name" required /></div>
              <div class="field"><label for="email">Email <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
              <div class="field"><label for="phone">Phone <span>*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></div>
            </div>
            <fieldset class="choice-group"><legend>Preferred contact method <span>*</span></legend><div class="segmented"><label><input type="radio" name="contactMethod" value="Phone call" required /><span>Phone call</span></label><label><input type="radio" name="contactMethod" value="Text message" required /><span>Text message</span></label><label><input type="radio" name="contactMethod" value="Email" required /><span>Email</span></label></div></fieldset>
            <div class="subsection"><div><span class="subsection__number">2</span><h3>Location & timing</h3></div><p>You can leave the date flexible.</p></div>
            <div class="field-grid">
              <div class="field field--wide"><label for="address">Cleaning address <span>*</span></label><input id="address" name="address" type="text" autocomplete="street-address" required placeholder="Street address, apartment or suite" /></div>
              <div class="field"><label for="city">City <span>*</span></label><input id="city" name="city" type="text" autocomplete="address-level2" required value="New York" /></div>
              <div class="field"><label for="zip">ZIP code <span>*</span></label><input id="zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" maxlength="5" required /></div>
              <div class="field"><label for="preferred-date">Preferred date</label><input id="preferred-date" name="preferredDate" type="date" /></div>
              <div class="field"><label for="preferred-time">Preferred time</label><select id="preferred-time" name="preferredTime"><option value="">Flexible / not sure yet</option><option>Morning · 8 AM–12 PM</option><option>Afternoon · 12–4 PM</option><option>Evening · after 4 PM</option></select></div>
            </div>
            <div class="step-actions"><button class="button button--outline" type="button" data-back>← Back</button><button class="button button--primary" type="button" data-next>Review request <span aria-hidden="true">→</span></button></div>
          </section>

          <section class="form-step" data-step="3" aria-labelledby="step-three-title" hidden>
            <div class="step-heading"><span>Step 3 of 3</span><h2 id="step-three-title">Review your request.</h2><p>Check the details below. This is a local preview and will not be submitted.</p></div>
            <div id="quote-summary" class="quote-summary" aria-live="polite"></div>
            <div class="simulation-callout"><span aria-hidden="true">✓</span><div><strong>No information will be sent.</strong><p>This planner has no email endpoint, database or submission action.</p></div></div>
            <div class="step-actions"><button class="button button--outline" type="button" data-back>← Change details</button><button class="button button--primary" id="complete-preview" type="button">Complete preview</button></div>
            <div id="preview-complete" class="preview-complete" role="status" tabindex="-1" hidden>
              <span aria-hidden="true">✓</span><div><strong>Your preview is complete.</strong><p>Nothing was sent or saved. To request service, call <a href={business.phoneHref}>{business.phone}</a>.</p><button type="button" data-reset>Start over</button></div>
            </div>
          </section>
        </form>
      </div>

      <aside class="booking-aside" aria-label="Quote information">
        <div class="aside-card">
          <p class="aside-card__label">What to expect</p>
          <h2>A clearer first conversation.</h2>
          <ul><li><span>01</span>Choose the right service.</li><li><span>02</span>Add only the relevant details.</li><li><span>03</span>Review everything together.</li></ul>
        </div>
        <div class="aside-contact"><p>Prefer to speak with Lourdes?</p><a href={business.phoneHref}>{business.phone}</a><small>{business.hours}</small></div>
      </aside>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#quote-builder");
    if (form) {
      const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
      const progressItems = [...document.querySelectorAll<HTMLElement>("[data-progress-step]")];
      const serviceDetails = form.querySelector<HTMLElement>("#service-details");
      const servicePanels = [...form.querySelectorAll<HTMLElement>("[data-service-panel]")];
      const summary = form.querySelector<HTMLElement>("#quote-summary");
      const completion = form.querySelector<HTMLElement>("#preview-complete");
      const dateInput = form.querySelector<HTMLInputElement>("#preferred-date");
      let currentStep = 1;

      if (dateInput) dateInput.min = new Date().toISOString().split("T")[0];

      const showStep = (step: number) => {
        currentStep = step;
        steps.forEach((section) => section.hidden = Number(section.dataset.step) !== step);
        progressItems.forEach((item) => {
          const number = Number(item.dataset.progressStep);
          item.classList.toggle("is-current", number === step);
          item.classList.toggle("is-complete", number < step);
          const marker = item.querySelector(":scope > span");
          if (marker) marker.textContent = number < step ? "✓" : String(number);
        });
        completion?.setAttribute("hidden", "");
        document.querySelector(".booking-section")?.scrollIntoView({ behavior: "smooth", block: "start" });
        steps.find((section) => Number(section.dataset.step) === step)?.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
      };

      const updateServicePanel = (value: string) => {
        if (serviceDetails) serviceDetails.hidden = !value;
        servicePanels.forEach((panel) => {
          const active = panel.dataset.servicePanel === value;
          panel.hidden = !active;
          panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-required]").forEach((input) => input.required = active);
        });
      };

      const validateStep = (step: number) => {
        const section = steps.find((item) => Number(item.dataset.step) === step);
        if (!section) return false;
        const required = [...section.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(":required")]
          .filter((input) => !input.closest<HTMLElement>("[hidden]"));
        const invalid = required.find((input) => !input.checkValidity());
        if (invalid) { invalid.reportValidity(); invalid.focus(); return false; }
        return true;
      };

      const valueOf = (name: string) => {
        const entries = new FormData(form).getAll(name).map(String).filter(Boolean);
        return entries.length ? entries.join(", ") : "Not specified";
      };

      const addSummaryRow = (label: string, value: string) => {
        const row = document.createElement("div");
        const term = document.createElement("dt");
        const detail = document.createElement("dd");
        term.textContent = label;
        detail.textContent = value;
        row.append(term, detail);
        return row;
      };

      const buildSummary = () => {
        if (!summary) return;
        const selectedService = form.querySelector<HTMLInputElement>('input[name="service"]:checked');
        const slug = selectedService?.value ?? "";
        const specific: Record<string, Array<[string, string]>> = {
          "residential-cleaning": [["Frequency", "residentialFrequency"], ["Home", "residentialBedrooms"], ["Bathrooms", "residentialBathrooms"], ["Approx. size", "residentialSize"]],
          "deep-cleaning": [["Home", "deepBedrooms"], ["Bathrooms", "deepBathrooms"], ["Approx. size", "deepSize"], ["Focus areas", "deepFocus"]],
          "move-in-out-cleaning": [["Move", "moveType"], ["Home", "moveBedrooms"], ["Bathrooms", "moveBathrooms"], ["Space status", "moveOccupancy"]],
          "commercial-cleaning": [["Business", "commercialType"], ["Approx. size", "commercialSize"], ["Frequency", "commercialFrequency"], ["Areas", "commercialAreas"]],
          "office-cleaning": [["Workplace", "officeType"], ["Approx. size", "officeSize"], ["Frequency", "officeFrequency"], ["Areas", "officeAreas"]],
        };
        const rows: Array<[string, string]> = [
          ["Service", selectedService?.dataset.title ?? "Not selected"],
          ["Service area", valueOf("serviceArea")],
          ...(specific[slug] ?? []).map(([label, name]) => [label, valueOf(name)] as [string, string]),
          ["Optional extras", valueOf("extras")],
          ["Preferred date", valueOf("preferredDate")],
          ["Preferred time", valueOf("preferredTime")],
          ["Name", `${valueOf("firstName")} ${valueOf("lastName")}`],
          ["Contact", `${valueOf("email")} · ${valueOf("phone")} · ${valueOf("contactMethod")}`],
          ["Cleaning address", `${valueOf("address")}, ${valueOf("city")}, NY ${valueOf("zip")}`],
          ["Notes", valueOf("notes")],
        ];
        const list = document.createElement("dl");
        rows.forEach(([label, value]) => list.append(addSummaryRow(label, value)));
        summary.replaceChildren(list);
      };

      form.addEventListener("change", (event) => {
        const target = event.target as HTMLInputElement;
        if (target.name === "service") updateServicePanel(target.value);
      });
      form.addEventListener("submit", (event) => event.preventDefault());
      form.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((button) => button.addEventListener("click", () => {
        if (!validateStep(currentStep)) return;
        if (currentStep === 2) buildSummary();
        showStep(Math.min(3, currentStep + 1));
      }));
      form.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((button) => button.addEventListener("click", () => showStep(Math.max(1, currentStep - 1))));
      form.querySelector<HTMLButtonElement>("#complete-preview")?.addEventListener("click", () => {
        if (!completion) return;
        completion.hidden = false;
        completion.focus();
      });
      form.querySelector<HTMLButtonElement>("[data-reset]")?.addEventListener("click", () => {
        form.reset();
        updateServicePanel("");
        showStep(1);
      });
    }
  </script>
</BaseLayout>

<style>
  .booking-hero { padding: clamp(2.5rem, 4.5vw, 4rem) 0 clamp(2.25rem, 4vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .booking-hero__inner { max-width: 54rem; text-align: center; }
  .booking-hero .eyebrow { margin-inline: auto; }
  .booking-hero h1 { margin: 0; font-size: clamp(2.65rem, 5vw, 4rem); line-height: .98; }
  .booking-hero p:not(.eyebrow) { max-width: 42rem; margin: 1rem auto 0; color: var(--ink-soft); font-size: 1.08rem; }
  .privacy-note { display: inline-flex; align-items: center; gap: .65rem; margin-top: 1.4rem; padding: .65rem 1rem; border: 1px solid rgba(111,60,130,.14); border-radius: 999px; color: var(--plum-deep); background: rgba(255,255,255,.72); font-size: .8rem; }
