---
import BaseLayout from "../layouts/BaseLayout.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import ServiceMap from "../components/ServiceMap.astro";
import ContactBand from "../components/ContactBand.astro";
import { business, services, reviews, faqs } from "../data/site";
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy" data-reveal>
        <p class="eyebrow">Home, apartment & office cleaning · New York City</p>
        <h1 class="display-title">Professional cleaning <em>planned around your space.</em></h1>
        <p class="hero__lede">Reliable care for NYC homes and workplaces, with clear communication from the first call to the finished space.</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/booking/">Plan your service</a>
          <a class="button button--outline" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <ul class="hero__proof" aria-label="Service highlights">
          <li>Cleaning tailored to your priorities</li>
          <li>One-time or recurring visits</li>
          <li>Homes, offices and move days</li>
        </ul>
      </div>
      <div class="hero__visual" data-reveal>
        <div class="hero__frame">
          <img src="/img/hero.webp" width="900" height="1200" alt="Bright New York City dining area after professional cleaning" fetchpriority="high" />
        </div>
      </div>
    </div>
    <div class="hero__wash" aria-hidden="true"></div>
  </section>

  <section class="services section warm-field" id="services">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Our cleaning services</p>
          <h2 class="section-title">Professional care for home and work.</h2>
        </div>
        <p>Choose the service that fits your space. We’ll confirm the scope, priorities and schedule before the visit.</p>
      </div>
      <div class="services__layout">
        <div class="services__primary" data-reveal>
          {services.slice(0, 2).map((service) => (
            <a class="services__card" href={`/services/${service.slug}/`}>
              <div class="services__icon" aria-hidden="true">
                {service.slug === "residential-cleaning" ? (
                  <svg viewBox="0 0 32 32" fill="none">
                    <path d="M4.5 14.2 16 4.8l11.5 9.4v12.1a1.7 1.7 0 0 1-1.7 1.7H6.2a1.7 1.7 0 0 1-1.7-1.7V14.2Z" />
                    <path d="M12 28V18h8v10M2.8 15.6 16 4.8l13.2 10.8" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 32 32" fill="none">
                    <path d="M5 28V10.5c0-.8.7-1.5 1.5-1.5H14v19M14 5.5c0-.8.7-1.5 1.5-1.5h10c.8 0 1.5.7 1.5 1.5V28M2.5 28h27" />
                    <path d="M9 14h1M9 19h1M9 24h1M19 9h3M19 14h3M19 19h3M19 24h3" />
                  </svg>
                )}
              </div>
              <div>
                <span>{service.eyebrow}</span>
                <h3>{service.title}</h3>
                <p>{service.short}</p>
                <strong>Explore service ↗</strong>
              </div>
            </a>
          ))}
        </div>
        <div class="services__list" data-reveal>
          {services.slice(2).map((service, index) => (
            <a href={`/services/${service.slug}/`}>
              <span class="services__number">0{index + 3}</span>
              <div><small>{service.eyebrow}</small><h3>{service.title}</h3><p>{service.short}</p></div>
              <span class="services__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="results section" id="results">
    <div class="container results__grid">
      <div class="results__copy" data-reveal>
        <p class="eyebrow">Real work. Visible difference.</p>
        <h2 class="section-title">See the care in the finish.</h2>
        <p class="lede">Move the slider to compare a real residential cleaning result. Our work is about more than looking tidy—it is the difference you notice when the whole room feels cared for.</p>
        <a class="text-link" href="/services/residential-cleaning/">See residential service details</a>
      </div>
      <div data-reveal>
        <BeforeAfter before="/img/before.webp" after="/img/after.webp" alt="Residential room cleaning transformation" />
      </div>
    </div>
  </section>

  <section class="care section">
    <div class="container care__grid">
      <div class="care__image" data-reveal>
        <img src="/img/team.webp" width="800" height="1000" alt="A Lules team member working carefully in a New York City space" loading="lazy" />
        <div class="care__stamp"><strong>10+</strong><span>years serving NYC</span></div>
      </div>
      <div class="care__copy" data-reveal>
        <p class="eyebrow">Professional, personal, prepared</p>
        <h2 class="section-title">A better visit starts before we arrive.</h2>
        <p class="lede">We ask the right questions, note your priorities and make sure the cleaner arrives with a clear plan for the space.</p>
        <ol>
          <li><span>01</span><div><h3>Tell us about the space</h3><p>Home or business, approximate size, priorities and preferred date.</p></div></li>
          <li><span>02</span><div><h3>Confirm the plan</h3><p>We recommend the right service, timing and supplies before the visit.</p></div></li>
          <li><span>03</span><div><h3>Enjoy the finished space</h3><p>We clean with attention to the areas that matter most to you.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="voices section warm-field">
    <div class="container">
      <div class="voices__head" data-reveal>
        <div><p class="eyebrow">Notes from clients</p><h2 class="section-title">What people noticed.</h2></div>
        <div class="voices__intro"><p>Feedback shared directly with the Lules team after residential and business cleaning visits.</p><a class="text-link" href="/reviews/">Read the reviews</a></div>
      </div>
      <div class="voices__grid" data-reveal>
        <blockquote class="voices__lead"><span aria-hidden="true">★★★★★</span><p>“{reviews[0]}”</p><footer>Client note · shared with Lules</footer></blockquote>
        <div class="voices__notes">
          {reviews.slice(1, 3).map((review) => <blockquote><span aria-hidden="true">★★★★★</span><p>“{review}”</p><footer>Client note · shared with Lules</footer></blockquote>)}
        </div>
      </div>
    </div>
  </section>

  <ServiceMap />

  <section class="faq-preview section--compact">
    <div class="container faq-preview__grid">
      <div data-reveal><p class="eyebrow">Good to know</p><h2 class="section-title">A few answers before you book.</h2><a class="text-link" href="/faq/">View all questions</a></div>
      <div class="faq-list" data-reveal>
        {faqs.slice(0, 3).map((item, index) => <details open={index === 0}><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--paper); }
  .hero__grid { position: relative; z-index: 2; display: grid; grid-template-columns: .96fr 1.04fr; align-items: center; gap: clamp(2.5rem, 6vw, 5.5rem); padding: clamp(3.75rem, 6vw, 5.75rem) 0; }
  .hero .display-title em { color: var(--rose); font-weight: 470; }
  .hero .display-title { max-width: 13ch; font-size: clamp(3rem, 5.2vw, 4.9rem); line-height: .98; }
  .hero__lede { max-width: 35rem; margin: 1.45rem 0 0; color: var(--ink-soft); font-size: clamp(1rem, 1.4vw, 1.16rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.7rem; }
  .hero__proof { display: grid; gap: .45rem; margin: 1.75rem 0 0; padding: 0; color: var(--ink-soft); font-size: .82rem; list-style: none; }
  .hero__proof li { display: flex; align-items: center; gap: .65rem; }
  .hero__proof li::before { display: grid; width: 1.15rem; height: 1.15rem; flex: none; place-items: center; border-radius: 50%; content: "✓"; color: white; background: var(--rose); font-size: .68rem; font-weight: 900; }
  .hero__visual { position: relative; justify-self: end; width: 100%; }
  .hero__frame { position: relative; aspect-ratio: 1.15 / 1; overflow: hidden; border-radius: var(--radius-lg); background: var(--blush); box-shadow: var(--shadow-lg); }
  .hero__frame img { width: 100%; height: 100%; object-fit: cover; }
  .hero__wash { position: absolute; top: -16rem; right: -12rem; width: min(50vw, 45rem); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(234,220,240,.55), rgba(245,220,227,.18) 58%, transparent 73%); }
  .section-head, .voices__head { display: grid; grid-template-columns: 1.2fr .8fr; gap: 3rem; align-items: end; margin-bottom: 3rem; }
  .section-head > p, .voices__intro { max-width: 31rem; margin: 0 0 .25rem auto; color: var(--ink-soft); }
  .voices__intro p { margin: 0 0 1rem; }
  .services__layout { display: grid; gap: 1.1rem; }
  .services__primary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
  .services__card { display: block; min-height: 0; overflow: hidden; padding: clamp(1.5rem, 3vw, 2.35rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--blush-soft); box-shadow: var(--shadow-sm); transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease; }
  .services__card:nth-child(2) { background: var(--lilac-soft); }
  .services__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .services__card:hover { border-color: rgba(111,60,130,.32); }
  .services__icon { display: grid; width: 3.25rem; height: 3.25rem; place-items: center; border: 1px solid rgba(111,60,130,.18); border-radius: 1rem; color: var(--plum-deep); background: rgba(255,255,255,.66); }
  .services__icon svg { width: 1.85rem; height: 1.85rem; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .services__card > div:last-child { margin-top: 1.75rem; }
  .services__card span, .services__list small { color: var(--rose); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .services__card:nth-child(2) span { color: var(--plum); }
  .services__card h3 { margin: .35rem 0 .5rem; font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1; }
  .services__card p { margin: 0; color: var(--ink-soft); font-size: .9rem; }
  .services__card strong { display: inline-block; margin-top: 1rem; color: var(--plum); font-size: .78rem; }
  .services__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .services__list a { display: grid; grid-template-columns: 1.6rem 1fr auto; gap: .75rem; align-items: start; padding: 1.35rem .8rem; border-bottom: 1px solid var(--line); transition: background 180ms ease, padding 180ms ease; }
  .services__list a + a { border-left: 1px solid var(--line); }
  .services__list a:hover { padding-inline: 1.2rem; background: rgba(255,255,255,.5); }
  .services__number { color: var(--rose); font-family: var(--font-display); }
  .services__list small { color: var(--rose); }
  .services__list h3 { margin: .1rem 0 .25rem; font-size: 1.35rem; }
  .services__list p { margin: 0; color: var(--ink-soft); font-size: .83rem; line-height: 1.5; }
  .services__arrow { color: var(--plum); font-size: 1.3rem; }
  .results__grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .results__copy .text-link { margin-top: 1.6rem; }
  .care { color: white; background: var(--plum-deep); }
  .care__grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .care__image { position: relative; }
  .care__image img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 12rem 12rem var(--radius-lg) var(--radius-lg); }
  .care__stamp { position: absolute; right: -1rem; bottom: 2rem; display: grid; width: 8rem; height: 8rem; place-content: center; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; text-align: center; background: var(--rose); box-shadow: var(--shadow-lg); }
  .care__stamp strong { font-family: var(--font-display); font-size: 2.4rem; line-height: .9; }
  .care__stamp span { width: 6rem; font-size: .66rem; }
  .care .eyebrow { color: var(--gold-soft); }
  .care .lede, .care li p { color: rgba(255,255,255,.68); }
  .care ol { display: grid; gap: 0; margin: 2.5rem 0 0; padding: 0; list-style: none; }
  .care li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid rgba(255,255,255,.16); }
  .care li > span { color: var(--gold-soft); font-family: var(--font-display); }
  .care li h3 { margin: 0; font-family: var(--font-body); font-size: 1rem; letter-spacing: 0; }
  .care li p { margin: .3rem 0 0; font-size: .88rem; }
  .voices__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 1rem; align-items: stretch; }
  .voices blockquote { margin: 0; }
  .voices blockquote span { color: var(--gold); letter-spacing: .16em; }
  .voices__lead { display: flex; min-height: 100%; flex-direction: column; justify-content: space-between; padding: clamp(2rem, 4vw, 3.5rem); border-radius: var(--radius-lg); color: white; background: var(--plum-deep); box-shadow: var(--shadow-lg); }
  .voices__lead p { margin: 2rem 0; font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2.15rem); line-height: 1.18; letter-spacing: -.02em; }
  .voices footer { color: inherit; opacity: .66; font-size: .74rem; }
  .voices__notes { display: grid; gap: 1rem; }
  .voices__notes blockquote { display: flex; min-height: 12rem; flex-direction: column; justify-content: space-between; padding: 1.45rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(255,255,255,.68); }
  .voices__notes blockquote:last-child { min-height: 0; }
  .voices__notes p { margin: .7rem 0 1.25rem; font-family: var(--font-display); font-size: 1.08rem; line-height: 1.32; }
  .faq-preview { border-top: 1px solid var(--line); background: var(--paper); }
  .faq-preview__grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 7vw, 7rem); }
  .faq-preview .text-link { margin-top: 1.5rem; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.35rem 0; list-style: none; font-weight: 800; cursor: pointer; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--rose); font-size: 1.4rem; transition: transform 180ms ease; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list p { max-width: 42rem; margin: -.35rem 0 1.35rem; color: var(--ink-soft); }
  @media (max-width: 58rem) {
    .hero__grid { min-height: auto; grid-template-columns: 1fr; }
    .hero__visual { justify-self: center; width: min(86%, 31rem); }
    .section-head, .voices__head, .results__grid, .care__grid, .voices__grid, .faq-preview__grid { grid-template-columns: 1fr; }
    .section-head > p, .voices__intro { margin-left: 0; }
    .services__list { grid-template-columns: 1fr; }
    .services__list a + a { border-left: 0; }
    .results__copy { max-width: 44rem; }
    .care__image { width: min(82%, 30rem); }
  }
  @media (max-width: 38rem) {
    .hero__grid { padding-top: 2.5rem; }
    .hero__actions { display: grid; }
    .hero__proof { grid-template-columns: 1fr; }
    .hero__visual { width: 100%; }
    .hero__frame { aspect-ratio: 4 / 3.4; border-radius: var(--radius-md); }
    .services__primary { grid-template-columns: 1fr; }
    .voices__notes { grid-template-columns: 1fr; }
    .voices__notes blockquote:last-child { grid-column: auto; }
    .services__list a { grid-template-columns: 1.6rem 1fr auto; padding-inline: 0; }
    .care__image { width: 100%; }
    .care__stamp { right: 0; }
    .voices__lead { min-height: 24rem; }
  }
</style>
