---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactBand from "../../components/ContactBand.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import { services } from "../../data/site";

const serviceOrder = [
  "residential-cleaning",
  "deep-cleaning",
  "move-in-out-cleaning",
  "commercial-cleaning",
  "office-cleaning",
];
const serviceDescriptions: Record<string, string> = {
  "residential-cleaning": "One-time or recurring cleaning for apartments, condos and homes.",
  "deep-cleaning": "A detailed reset for buildup and the areas that are often overlooked.",
  "move-in-out-cleaning": "Detailed cleaning for an empty or nearly empty home.",
  "commercial-cleaning": "One-time or recurring cleaning for retail and hospitality spaces.",
  "office-cleaning": "Reliable workplace cleaning planned around your team and schedule.",
};
const serviceCards = serviceOrder
  .map((slug) => services.find((service) => service.slug === slug))
  .filter(Boolean);
---
<BaseLayout title="Cleaning Services in NYC | Lules Multiservices" description="Explore residential, commercial, office, move-in/out and deep cleaning services from Lules Multiservices in New York City.">
  <header class="page-hero warm-field">
    <div class="container page-hero__grid">
      <div data-reveal><p class="eyebrow">Cleaning services</p><h1 class="display-title">Cleaning for every kind of space.</h1></div>
      <p class="lede" data-reveal>Choose the right starting point. We’ll confirm the details and tailor the visit to your space.</p>
    </div>
  </header>
  <section class="service-index section">
    <div class="container service-index__grid">
      {serviceCards.map((service) => (
        <a class="service-card" href={`/services/${service.slug}/`} data-reveal>
          <ServiceIcon name={service.slug} />
          <h2>{service.title}</h2>
          <p>{serviceDescriptions[service.slug] ?? service.short}</p>
          <strong>Explore service <span aria-hidden="true">↗</span></strong>
        </a>
      ))}
    </div>
  </section>
  <ContactBand compact />
</BaseLayout>
<style>
  .page-hero { padding-block: clamp(3rem, 4.5vw, 4.5rem); border-bottom: 1px solid var(--line); }
  .page-hero__grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .page-hero .display-title { max-width: 13ch; font-size: clamp(2.75rem, 4.8vw, 4.25rem); line-height: .98; }
  .page-hero .lede { max-width: 35rem; margin: 0 0 .35rem; }
  .service-index { padding-block: clamp(3rem, 5vw, 5rem); }
  .service-index__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .service-card { display: flex; min-height: 17rem; flex-direction: column; align-items: center; justify-content: center; padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid transparent; border-radius: var(--radius-lg); background: #f7f7f8; text-align: center; transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
  .service-card:nth-child(even) { background: #f2edf6; }
  .service-card:nth-child(3n) { background: var(--blush-soft); }
  .service-card:last-child { grid-column: 1 / -1; }
  .service-card:hover { transform: translateY(-3px); border-color: rgba(111,60,130,.2); box-shadow: var(--shadow-sm); }
  .service-card h2 { margin: 1.15rem 0 .6rem; font-family: var(--font-body); font-size: clamp(1.4rem, 2.4vw, 1.8rem); font-weight: 650; line-height: 1.15; letter-spacing: -.035em; }
  .service-card p { max-width: 29rem; margin: 0; color: var(--ink-soft); font-size: .95rem; }
  .service-card strong { margin-top: 1.2rem; color: var(--plum); font-size: .82rem; }
  .service-card strong span { margin-left: .35rem; transition: transform 180ms ease; }
  .service-card:hover strong span { display: inline-block; transform: translate(.15rem, -.1rem); }
  @media (max-width: 48rem) {
    .page-hero__grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .page-hero .lede { margin: 0; }
    .service-index__grid { grid-template-columns: 1fr; }
    .service-card, .service-card:last-child { min-height: 15rem; grid-column: auto; }
  }
</style>
