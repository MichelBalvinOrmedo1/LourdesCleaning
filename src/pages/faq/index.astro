---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactBand from "../../components/ContactBand.astro";
import { faqs, business } from "../../data/site";
---
<BaseLayout title="Cleaning FAQ | Lules Multiservices NYC" description="Answers about booking, supplies, service areas, recurring cleaning and policies from Lules Multiservices in New York City.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  })} />
  <header class="faq-hero warm-field">
    <div class="container faq-hero__grid">
      <div data-reveal><p class="eyebrow">Before your visit</p><h1 class="display-title">Questions, answered clearly.</h1></div>
      <div class="faq-hero__summary" data-reveal>
        <p>Everything you need to plan your first cleaning—from payment and scheduling to coverage and policies.</p>
        <a class="text-link" href={business.phoneHref}>Ask us directly</a>
      </div>
    </div>
  </header>
  <section class="faq-page section">
    <div class="container faq-page__grid">
      <aside data-reveal><p class="eyebrow">Need a quick answer?</p><h2>Speak with the Lules team.</h2><p>We can confirm availability, scope and the best cleaning option for your space.</p><a class="button button--light" href={business.phoneHref}>Call {business.phone}</a></aside>
      <div class="faq-list" data-reveal>
        {faqs.map((item, index) => <details open={index === 0}><summary><span>0{index + 1}</span><strong>{item.question}</strong><i>+</i></summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>
  <ContactBand compact />
</BaseLayout>
<style>
  .faq-hero { padding: clamp(2.5rem, 4vw, 4rem) 0 clamp(2.75rem, 4.5vw, 4.5rem); border-bottom: 1px solid var(--line); }
  .faq-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .58fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .faq-hero .display-title { max-width: 10ch; font-size: clamp(3.3rem, 6vw, 5.8rem); line-height: .92; }
  .faq-hero__summary { max-width: 31rem; padding: 1.25rem 0 1.25rem 1.5rem; border-left: 2px solid var(--gold); }
  .faq-hero__summary p { margin: 0 0 1rem; color: var(--ink-soft); font-size: 1.05rem; }
  .faq-page { padding-block: clamp(3rem, 5vw, 5rem); }
  .faq-page__grid { display: grid; grid-template-columns: minmax(15rem, .5fr) minmax(0, 1.5fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq-page aside { position: sticky; top: 8.5rem; padding: 2rem; border-radius: var(--radius-lg); color: white; background: linear-gradient(145deg, var(--plum-deep), var(--plum)); box-shadow: var(--shadow-lg); }
  .faq-page aside .eyebrow { color: var(--gold-soft); }
  .faq-page aside h2 { max-width: 9ch; margin: 0; color: white; font-size: 2.25rem; line-height: 1; }
  .faq-page aside > p:not(.eyebrow) { color: rgba(255,255,255,.75); }
  .faq-page aside .button { margin-top: 1rem; }
  .faq-list { display: grid; gap: .75rem; }
  .faq-list details { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-md); background: rgba(255,255,255,.72); transition: border-color 180ms ease, box-shadow 180ms ease; }
  .faq-list details[open] { border-color: rgba(111,60,130,.28); box-shadow: var(--shadow-sm); }
  .faq-list summary { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; align-items: center; padding: 1.35rem 1.5rem; list-style: none; cursor: pointer; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary > span { color: var(--rose); font-family: var(--font-display); }
  .faq-list summary strong { font-size: 1rem; }
  .faq-list summary i { color: var(--plum); font-size: 1.5rem; font-style: normal; transition: transform 180ms ease; }
  .faq-list details[open] summary i { transform: rotate(45deg); }
  .faq-list details > p { max-width: 43rem; margin: -.1rem 2rem 1.5rem 5rem; color: var(--ink-soft); }
  @media (max-width: 48rem) { .faq-hero__grid, .faq-page__grid { grid-template-columns: 1fr; } .faq-hero__grid { gap: 1.75rem; } .faq-hero__summary { max-width: 40rem; } .faq-page aside { position: static; } }
  @media (max-width: 34rem) { .faq-list summary { grid-template-columns: 2rem 1fr auto; padding: 1.15rem 1rem; } .faq-list details > p { margin: 0 1rem 1.25rem 3rem; } }
</style>
