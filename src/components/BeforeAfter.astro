---
interface Props { before: string; after: string; alt: string; }
const { before, after, alt } = Astro.props;
const id = `compare-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="compare" data-compare style="--position: 50%">
  <div class="compare__image">
    <img src={after} alt={`${alt}, after professional cleaning`} width="900" height="675" loading="lazy" />
    <div class="compare__before" aria-hidden="true">
      <img src={before} alt="" width="900" height="675" loading="lazy" />
    </div>
    <span class="compare__label compare__label--before">Before</span>
    <span class="compare__label compare__label--after">After</span>
    <div class="compare__line" aria-hidden="true"><span>↔</span></div>
  </div>
  <label class="sr-only" for={id}>Move the slider to compare before and after cleaning</label>
  <input id={id} type="range" min="0" max="100" value="50" aria-valuetext="Half before and half after" />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((compare) => {
    const range = compare.querySelector<HTMLInputElement>('input[type="range"]');
    if (!range) return;
    const update = () => {
      compare.style.setProperty('--position', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value} percent before, ${100 - Number(range.value)} percent after`);
    };
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .compare { position: relative; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .compare__image { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--lilac-soft); }
  .compare img { width: 100%; height: 100%; object-fit: cover; }
  .compare__before { position: absolute; inset: 0; overflow: hidden; clip-path: inset(0 calc(100% - var(--position)) 0 0); }
  .compare__before img { width: 100%; }
  .compare__line { position: absolute; top: 0; bottom: 0; left: var(--position); width: 3px; transform: translateX(-50%); background: white; box-shadow: 0 0 0 1px rgba(41,25,46,.18); }
  .compare__line span { position: absolute; top: 50%; left: 50%; display: grid; width: 3rem; height: 3rem; place-items: center; transform: translate(-50%, -50%); border: 3px solid white; border-radius: 50%; color: white; background: var(--plum); box-shadow: var(--shadow-sm); font-weight: 900; }
  .compare__label { position: absolute; top: 1rem; z-index: 2; padding: .45rem .7rem; border-radius: 999px; color: white; background: rgba(41,25,46,.8); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .compare__label--before { left: 1rem; }
  .compare__label--after { right: 1rem; color: var(--plum-deep); background: rgba(255,255,255,.9); }
  .compare input { position: absolute; z-index: 4; inset: 0; width: 100%; height: 100%; margin: 0; cursor: ew-resize; opacity: 0; }
</style>
