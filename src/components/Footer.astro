---
import { business, services, areas } from "../data/site";
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/img/logo-multiservices.webp" width="132" height="68" alt="Lules Multiservices" />
      <strong class="footer__name">Lules Multiservices</strong>
      <p>Professional cleaning for New York City homes and businesses, delivered with care since 2014.</p>
    </div>
    <div>
      <h2>Services</h2>
      {services.slice(0, 4).map((service) => <a href={`/services/${service.slug}/`}>{service.title}</a>)}
    </div>
    <div>
      <h2>Service areas</h2>
      {areas.map((area) => <a href={`/areas/${area.slug}/`}>{area.name}</a>)}
    </div>
    <div>
      <h2>Contact</h2>
      <a href={business.phoneHref}>{business.phone}</a>
      <a href={business.emailHref}>{business.email}</a>
      <p>{business.location}</p>
      <p>{business.hours}</p>
      <a href={business.instagram} target="_blank" rel="noreferrer">Instagram</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {new Date().getFullYear()} Lules Multiservices</span>
    <span>{business.serviceArea}</span>
  </div>
</footer>
<style>
  .footer { padding-top: 4.5rem; color: #fff8fc; background: var(--plum-deep); }
  .footer__grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 3rem; padding-bottom: 4rem; }
  .footer__brand img { width: 8rem; height: 4.6rem; padding: .3rem; object-fit: contain; border-radius: .75rem; background: white; }
  .footer__name { display: block; margin-top: .75rem; font-family: var(--font-display); font-size: 1.35rem; }
  .footer p { max-width: 24rem; margin: .8rem 0 0; color: rgba(255,248,252,.72); }
  .footer h2 { margin: 0 0 1.1rem; color: var(--gold-soft); font-family: var(--font-body); font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; }
  .footer__grid > div:not(.footer__brand) { display: flex; flex-direction: column; align-items: flex-start; gap: .65rem; }
  .footer a { color: rgba(255,248,252,.82); font-size: .88rem; }
  .footer a:hover { color: white; }
  .footer__bottom { display: flex; min-height: 4.3rem; align-items: center; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.16); color: rgba(255,248,252,.56); font-size: .74rem; }
  @media (max-width: 52rem) { .footer__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 34rem) { .footer__grid { grid-template-columns: 1fr; gap: 2rem; } .footer__bottom { align-items: flex-start; flex-direction: column; justify-content: center; gap: .25rem; } }
</style>
