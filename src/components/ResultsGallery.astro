---
type GalleryItem =
  | { type: "before-after"; before: string; after: string; alt: string }
  | { type: "single"; image: string; alt: string };

interface Props {
  items: GalleryItem[];
  label: string;
  id: string;
}

const { items, label, id } = Astro.props;
---

<div class="gallery" id={id} data-gallery role="region" aria-label={label} tabindex="0">
  <div class="gallery__stage">
    {items.map((item, index) => (
      <figure class="gallery__slide" data-gallery-slide data-label={item.alt} hidden={index !== 0}>
        {item.type === "before-after" ? (
          <div class="comparison" style="--position: 50%">
            <img src={item.after} alt={`${item.alt}, after cleaning`} width="1200" height="900" loading={index === 0 ? "eager" : "lazy"} />
            <div class="comparison__before" aria-hidden="true"><img src={item.before} alt="" width="1200" height="900" loading="lazy" /></div>
            <span class="gallery__label gallery__label--before">Before</span>
            <span class="gallery__label gallery__label--after">After</span>
            <span class="comparison__line" aria-hidden="true"><b>↔</b></span>
            <input class="comparison__control" data-compare type="range" min="8" max="92" value="50" aria-label={`Compare before and after: ${item.alt}`} aria-valuetext="50 percent before, 50 percent after" />
          </div>
        ) : (
          <div class="finished"><img src={item.image} alt={item.alt} width="1200" height="900" loading={index === 0 ? "eager" : "lazy"} /><span class="gallery__label gallery__label--after">Finished space</span></div>
        )}
      </figure>
    ))}

    {items.length > 1 && (
      <>
        <button class="gallery__arrow gallery__arrow--prev" type="button" data-prev aria-label="Previous result">←</button>
        <button class="gallery__arrow gallery__arrow--next" type="button" data-next aria-label="Next result">→</button>
      </>
    )}
    <p class="gallery__counter" aria-hidden="true"><span data-current>1</span> / {items.length}</p>
    <p class="sr-only" aria-live="polite" data-live>Showing result 1 of {items.length}: {items[0]?.alt}</p>
  </div>

  {items.length > 1 && (
    <div class="gallery__catalog">
      <div class="gallery__catalog-head"><h3>View all results</h3><p>Select a project to view it above.</p></div>
      <div class="gallery__rail" data-rail>
        {items.map((item, index) => (
          <button class="gallery__thumb" type="button" data-thumb data-index={index} aria-label={`Show result ${index + 1}: ${item.alt}`} aria-pressed={index === 0 ? "true" : "false"}>
            <img src={item.type === "before-after" ? item.after : item.image} alt="" width="240" height="160" loading="lazy" />
            <span>{item.type === "before-after" ? "Before / after" : "Finished"}</span>
          </button>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
    const current = root.querySelector<HTMLElement>("[data-current]");
    const live = root.querySelector<HTMLElement>("[data-live]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = 0;

    const show = (requested: number) => {
      active = (requested + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.hidden = index !== active; });
      thumbs.forEach((thumb, index) => thumb.setAttribute("aria-pressed", String(index === active)));
      if (current) current.textContent = String(active + 1);
      if (live) live.textContent = `Showing result ${active + 1} of ${slides.length}: ${slides[active]?.dataset.label ?? "Cleaning result"}`;
      thumbs[active]?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "nearest", inline: "center" });
    };

    root.querySelectorAll<HTMLButtonElement>("[data-prev]").forEach((button) => button.addEventListener("click", () => show(active - 1)));
    root.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((button) => button.addEventListener("click", () => show(active + 1)));
    thumbs.forEach((thumb) => thumb.addEventListener("click", () => show(Number(thumb.dataset.index))));
    root.querySelectorAll<HTMLInputElement>("[data-compare]").forEach((control) => control.addEventListener("input", () => {
      control.closest<HTMLElement>(".comparison")?.style.setProperty("--position", `${control.value}%`);
      control.setAttribute("aria-valuetext", `${control.value} percent before, ${100 - Number(control.value)} percent after`);
    }));
    root.addEventListener("keydown", (event) => {
      if ((event.target as HTMLElement).matches("input[type='range']")) return;
      if (event.key === "ArrowLeft") { event.preventDefault(); show(active - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); show(active + 1); }
    });
  });
</script>

<style>
  .gallery { min-width: 0; }
  .gallery__stage { position: relative; width: min(100%, 68rem); margin-inline: auto; }
  .gallery__slide { margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--lilac-soft); box-shadow: var(--shadow-lg); }
  .gallery__slide[hidden] { display: none; }
  .comparison, .finished { position: relative; aspect-ratio: 16 / 10; min-height: 26rem; overflow: hidden; }
  .comparison img, .finished img { width: 100%; height: 100%; object-fit: cover; }
  .comparison__before { position: absolute; inset: 0; overflow: hidden; clip-path: inset(0 calc(100% - var(--position)) 0 0); }
  .gallery__label { position: absolute; z-index: 3; top: 1rem; padding: .45rem .75rem; border-radius: 999px; color: white; background: rgba(41,25,46,.86); font-size: .67rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .gallery__label--before { left: 1rem; }
  .gallery__label--after { right: 1rem; color: var(--plum-deep); background: rgba(255,255,255,.92); }
  .comparison__line { position: absolute; z-index: 4; top: 0; bottom: 0; left: var(--position); width: 2px; transform: translateX(-50%); background: var(--gold); pointer-events: none; }
  .comparison__line b { position: absolute; top: 50%; left: 50%; display: grid; width: 3rem; height: 3rem; place-items: center; transform: translate(-50%, -50%); border: 3px solid white; border-radius: 50%; color: white; background: var(--plum); box-shadow: var(--shadow-sm); }
  .comparison__control { position: absolute; z-index: 5; inset: 0; width: 100%; height: 100%; margin: 0; cursor: ew-resize; opacity: 0; }
  .comparison:focus-within .comparison__line b { outline: 3px solid var(--gold); outline-offset: 3px; }
  .gallery__arrow { position: absolute; z-index: 7; top: 50%; display: grid; width: 3rem; height: 3rem; place-items: center; transform: translateY(-50%); border: 1px solid var(--line); border-radius: 50%; color: var(--plum-deep); background: rgba(255,255,255,.94); box-shadow: var(--shadow-sm); font-size: 1.1rem; cursor: pointer; }
  .gallery__arrow--prev { left: 1rem; }
  .gallery__arrow--next { right: 1rem; }
  .gallery__counter { position: absolute; z-index: 7; bottom: 1rem; left: 50%; margin: 0; padding: .45rem .8rem; transform: translateX(-50%); border-radius: 999px; color: white; background: rgba(41,25,46,.9); font-family: var(--font-display); }
  .gallery__catalog { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .gallery__catalog-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; align-items: end; margin-bottom: 1rem; }
  .gallery__catalog h3 { margin: 0; color: var(--plum); font-size: clamp(1.5rem, 3vw, 2rem); }
  .gallery__catalog p { margin: 0; color: var(--ink-soft); font-size: .8rem; }
  .gallery__rail { display: flex; gap: .75rem; overflow-x: auto; padding: .2rem .1rem .8rem; scrollbar-color: var(--gold) transparent; scrollbar-width: thin; scroll-snap-type: x proximity; }
  .gallery__thumb { position: relative; flex: 0 0 clamp(7rem, 14vw, 10rem); height: 6rem; padding: 0; overflow: hidden; border: 2px solid transparent; border-radius: var(--radius-sm); background: white; cursor: pointer; scroll-snap-align: center; transition: transform 180ms ease, border-color 180ms ease; }
  .gallery__thumb:hover { transform: translateY(-2px); }
  .gallery__thumb[aria-pressed="true"] { border-color: var(--gold); box-shadow: var(--shadow-sm); }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb span { position: absolute; right: .35rem; bottom: .35rem; left: .35rem; padding: .25rem .35rem; border-radius: .35rem; color: white; background: rgba(41,25,46,.84); font-size: .62rem; font-weight: 750; }
  @media (max-width: 38rem) {
    .comparison, .finished { aspect-ratio: 4 / 5; min-height: 0; }
    .gallery__arrow { width: 2.6rem; height: 2.6rem; }
    .gallery__arrow--prev { left: .65rem; }
    .gallery__arrow--next { right: .65rem; }
  }
  @media (prefers-reduced-motion: reduce) { .gallery__thumb { transition: none; } }
</style>
