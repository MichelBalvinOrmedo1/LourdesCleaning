---
interface Props { name: string; }
const { name } = Astro.props;
---

<span class="service-icon" aria-hidden="true">
  {name === "residential-cleaning" && (
    <svg viewBox="0 0 32 32" fill="none"><path d="M4.5 14.2 16 4.8l11.5 9.4v12.1a1.7 1.7 0 0 1-1.7 1.7H6.2a1.7 1.7 0 0 1-1.7-1.7V14.2Z"/><path d="M12 28V18h8v10M2.8 15.6 16 4.8l13.2 10.8"/></svg>
  )}
  {name === "deep-cleaning" && (
    <svg viewBox="0 0 32 32" fill="none"><path d="M16 4.5c.8 5.7 3.8 8.7 9.5 9.5-5.7.8-8.7 3.8-9.5 9.5-.8-5.7-3.8-8.7-9.5-9.5 5.7-.8 8.7-3.8 9.5-9.5Z"/><path d="M25.5 4v5M23 6.5h5M7 22v4M5 24h4"/></svg>
  )}
  {name === "move-in-out-cleaning" && (
    <svg viewBox="0 0 32 32" fill="none"><path d="M3.5 8.5h16v15h-16zM19.5 14h4.8l4.2 4.5v5h-9z"/><path d="M8.5 27a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM24 27a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM19.5 18.5h9"/></svg>
  )}
  {name === "commercial-cleaning" && (
    <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V11h24v17M2.5 28h27M6 11l2-6h16l2 6"/><path d="M8 11v3a3 3 0 0 0 6 0v-3M14 11v3a3 3 0 0 0 6 0v-3M20 11v3a3 3 0 0 0 6 0v-3M9 28v-8h14v8"/></svg>
  )}
  {name === "office-cleaning" && (
    <svg viewBox="0 0 32 32" fill="none"><path d="M5 28V10.5c0-.8.7-1.5 1.5-1.5H14v19M14 5.5c0-.8.7-1.5 1.5-1.5h10c.8 0 1.5.7 1.5 1.5V28M2.5 28h27"/><path d="M9 14h1M9 19h1M9 24h1M19 9h3M19 14h3M19 19h3M19 24h3"/></svg>
  )}
</span>

<style>
  .service-icon { display: grid; width: 3.25rem; height: 3.25rem; place-items: center; border: 1px solid rgba(111,60,130,.16); border-radius: 1rem; color: var(--plum-deep); background: rgba(255,255,255,.62); }
  svg { width: 1.75rem; height: 1.75rem; stroke: currentColor; stroke-width: 1.85; stroke-linecap: round; stroke-linejoin: round; }
</style>
